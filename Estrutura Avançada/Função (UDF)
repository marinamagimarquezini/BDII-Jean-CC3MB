DELIMITER $$
CREATE FUNCTION total_gasto_cliente(p_idCliente INT) 
RETURNS BIGINT
DETERMINISTIC
BEGIN
    DECLARE total_gasto BIGINT;
    
    SELECT SUM(custo_total) INTO total_gasto
    FROM Fatura_servico
    WHERE idCliente = p_idCliente;
    
    RETURN IFNULL(total_gasto, 0);
END$$
DELIMITER ;
